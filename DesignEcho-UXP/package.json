{
  "name": "designecho-uxp",
  "version": "1.0.0",
  "description": "DesignEcho - AI-powered design assistant for Photoshop",
  "main": "dist/runtime.js",
  "scripts": {
    "build": "npm run build:typecheck && webpack --mode production",
    "build:warning-boundary": "node scripts/check-build-warning-boundary.cjs",
    "build:typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "webpack --mode development",
    "generate:icons": "python scripts/generate_plugin_icons.py",
    "audit:photoshop-transaction-ownership": "node scripts/audit-photoshop-transaction-ownership.cjs",
    "test": "npm run test:image-target-fit && npm run test:sku-pose-alignment-provider",
    "test:sku-pose-alignment-provider": "node scripts/test-sku-pose-alignment-provider.cjs",
    "test:image-target-fit": "node scripts/test-image-target-fit.cjs",
    "watch": "webpack --mode development --watch"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "keywords": [
    "photoshop",
    "uxp",
    "design",
    "ai",
    "assistant"
  ],
  "author": "DesignEcho",
  "license": "MIT"
}
