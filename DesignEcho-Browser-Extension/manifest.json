{
  "manifest_version": 3,
  "name": "DesignEcho 浏览器助手",
  "version": "1.2.0",
  "description": "连接本机 DesignEcho Agent（仅与 127.0.0.1 通信）：Agent 可读取网页与截图；你也可以一键收藏链接、图片与截图到 DesignEcho。",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage", "alarms", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DesignEcho 浏览器助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "collect-save-link": {
      "suggested_key": { "default": "Alt+Shift+0" },
      "description": "收藏当前页面链接到 DesignEcho"
    },
    "collect-batch": {
      "suggested_key": { "default": "Alt+Shift+1" },
      "description": "批量收藏页面图片到 DesignEcho"
    },
    "collect-region": {
      "suggested_key": { "default": "Alt+Shift+2" },
      "description": "区域截图收藏到 DesignEcho"
    },
    "collect-visible": {
      "suggested_key": { "default": "Alt+Shift+3" },
      "description": "可视范围截图收藏到 DesignEcho"
    },
    "collect-fullpage": {
      "description": "整页截图收藏到 DesignEcho（可在 chrome://extensions/shortcuts 自定义快捷键）"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
