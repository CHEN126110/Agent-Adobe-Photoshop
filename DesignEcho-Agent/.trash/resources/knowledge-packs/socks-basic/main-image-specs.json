{
  "version": "1.0.0",
  "description": "主图设计规范 - 点击图/转化图设计要点",
  
  "platforms": {
    "taobao": {
      "name": "淘宝/天猫",
      "mainImageCount": 5,
      "sizes": [
        { "ratio": "1:1", "width": 800, "height": 800, "name": "方图" },
        { "ratio": "3:4", "width": 750, "height": 1000, "name": "竖图" }
      ],
      "videoSize": { "ratio": "3:4", "maxDuration": 60 },
      "rules": [
        "首图不可有牛皮癣(促销文字)",
        "白底图要求纯白背景(RGB 255)",
        "不可有边框、水印"
      ]
    },
    "douyin": {
      "name": "抖音电商",
      "mainImageCount": 5,
      "sizes": [
        { "ratio": "1:1", "width": 800, "height": 800, "name": "方图" },
        { "ratio": "3:4", "width": 750, "height": 1000, "name": "竖图" }
      ],
      "rules": [
        "建议竖图3:4比例",
        "重点突出产品，文字精简",
        "适配手机端浏览"
      ]
    },
    "pdd": {
      "name": "拼多多",
      "mainImageCount": 10,
      "sizes": [
        { "ratio": "1:1", "width": 750, "height": 750, "name": "方图" }
      ],
      "rules": [
        "首图必须白底",
        "可添加促销标签",
        "产品占比大于70%"
      ]
    }
  },

  "imageTypes": [
    {
      "id": "click-image",
      "name": "点击主图",
      "purpose": "吸引点击，提升CTR",
      "position": [1, 2],
      "designPrinciples": [
        "产品清晰可见，占比60-80%",
        "背景干净或场景化",
        "核心卖点一眼可见",
        "构图有呼吸感"
      ],
      "dos": [
        "产品居中或三分法构图",
        "使用高质量产品图",
        "光线均匀，颜色准确",
        "背景与产品有对比"
      ],
      "donts": [
        "文字过多",
        "背景杂乱",
        "产品模糊或变形",
        "过度后期处理"
      ],
      "styles": [
        {
          "name": "简约白底",
          "desc": "纯白背景+产品，干净专业",
          "suitable": ["标品", "多颜色展示"]
        },
        {
          "name": "场景氛围",
          "desc": "生活场景背景，增加代入感",
          "suitable": ["非标品", "需要情感连接"]
        },
        {
          "name": "渐变色块",
          "desc": "渐变背景+产品，时尚现代",
          "suitable": ["年轻用户", "潮流产品"]
        }
      ]
    },
    {
      "id": "conversion-image",
      "name": "转化图",
      "purpose": "促进下单，解决购买顾虑",
      "position": [3, 4, 5],
      "designPrinciples": [
        "聚焦单一卖点",
        "痛点+解决方案",
        "数据/对比增强说服力",
        "行动号召明确"
      ],
      "types": [
        {
          "name": "痛点对比图",
          "structure": "问题(X) vs 解决(✓)",
          "example": "掉跟? → 硅胶防滑 稳如磐石"
        },
        {
          "name": "卖点放大图",
          "structure": "细节特写 + 卖点说明",
          "example": "无骨缝头 → 放大展示接缝处"
        },
        {
          "name": "数据证言图",
          "structure": "数字 + 背书",
          "example": "抑菌率99% SGS认证"
        },
        {
          "name": "场景使用图",
          "structure": "使用场景 + 效果",
          "example": "运动/通勤/居家 场景图"
        }
      ],
      "dos": [
        "每张图聚焦1个核心信息",
        "文案简短有力",
        "图文结合，信息清晰",
        "保持整体风格统一"
      ],
      "donts": [
        "信息堆砌",
        "文案过长",
        "风格不统一",
        "卖点重复"
      ]
    },
    {
      "id": "white-background",
      "name": "白底图",
      "purpose": "平台规范要求，用于搜索展示",
      "position": [5],
      "requirements": [
        "纯白背景 RGB(255,255,255)",
        "产品完整展示",
        "无文字、无水印",
        "产品占比80%以上"
      ],
      "shootingTips": [
        "使用白色背景纸或灯箱",
        "光线均匀无阴影",
        "产品平铺或简单造型",
        "后期调整至纯白"
      ]
    }
  ],

  "conversionFormulas": [
    {
      "name": "痛点公式",
      "structure": "还在为{痛点}烦恼? {产品}帮你{解决方案}",
      "examples": [
        "还在为脚臭尴尬? 银离子袜帮你48小时清爽",
        "还在为掉跟困扰? 硅胶防滑设计 一步到位"
      ]
    },
    {
      "name": "对比公式",
      "structure": "普通袜子{问题} vs 我们的袜子{优势}",
      "examples": [
        "普通袜穿一天就臭 vs 我们7天依然清爽",
        "普通袜口勒脚踝 vs 我们无痕宽口零压感"
      ]
    },
    {
      "name": "数据公式",
      "structure": "{数字}+{单位}+{效果说明}",
      "examples": [
        "抑菌率99.9% 持久抗菌",
        "透气孔800+个 清爽不闷脚",
        "销量突破1000万双 好评如潮"
      ]
    },
    {
      "name": "场景公式",
      "structure": "{场景}穿{产品类型} {效果}",
      "examples": [
        "运动穿吸汗袜 干爽不打滑",
        "通勤穿船袜 低帮不露边",
        "冬天穿羊毛袜 温暖又透气"
      ]
    }
  ],

  "colorGuidelines": {
    "background": [
      { "name": "纯白", "hex": "#FFFFFF", "use": "白底图、简约风" },
      { "name": "浅灰", "hex": "#F5F5F5", "use": "柔和背景" },
      { "name": "米白", "hex": "#FAF8F5", "use": "温馨感" },
      { "name": "浅蓝", "hex": "#E8F4FD", "use": "清爽感" },
      { "name": "浅粉", "hex": "#FFF0F5", "use": "女性向" }
    ],
    "accent": [
      { "name": "促销红", "hex": "#FF4D4F", "use": "价格、促销" },
      { "name": "品质金", "hex": "#D4AF37", "use": "高端、品质" },
      { "name": "信任蓝", "hex": "#1890FF", "use": "认证、保障" },
      { "name": "自然绿", "hex": "#52C41A", "use": "环保、健康" }
    ]
  }
}
